# 可选的机器级覆盖项。相同WA2网络基线下可直接使用默认值。
HILSERL_IMAGE=hilserl:actor-v1
HILSERL_CONTAINER_NAME=hilserl

# 仅旧Orin构建镜像时使用；新Orin加载镜像后不需要该基础镜像标签。
HILSERL_BASE_IMAGE=ros1_docker:latest
HILSERL_IMAGE_VERSION=actor-v1
HILSERL_SOURCE_REVISION=unknown

DISPLAY=:0
ROS_MASTER_URI=http://192.168.217.1:11311
ROS_IP=192.168.217.100
ROS_HOSTNAME=192.168.217.100
